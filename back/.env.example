# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values

# =====================
# APPLICATION
# =====================
NODE_ENV=development
PORT=4000
APP_NAME=ECommerce API

# =====================
# DATABASE
# =====================
# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/?appName=YourApp

# Database Logging (true/false)
DB_LOGGING=false

# =====================
# AUTHENTICATION
# =====================
# JWT Secret (IMPORTANT: Use a long random string in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=7825cdd20bba3ebd27b2690d2afff5b7a53f17531d0d1e96859612e8f7861d264f532b96446f9ec49e45fbbc9dfeb42dca3c39a1d08e215424671170fa6ca2f5

# JWT Expiration
JWT_EXPIRES_IN=7d

# Bcrypt Salt Rounds
BCRYPT_ROUNDS=10

# =====================
# FRONTEND
# =====================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Additional allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================
# CLOUDINARY (Image Storage)
# =====================
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =====================
# EMAIL SERVICE (Optional)
# =====================
# For sending emails (password reset, verification, etc.)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourapp.com

# =====================
# PAYMENT GATEWAY (Optional)
# =====================
# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# =====================
# LOGGING
# =====================
# Log Level: ERROR | WARN | INFO | HTTP | DEBUG
LOG_LEVEL=INFO

# =====================
# RATE LIMITING
# =====================
# Max requests per window (15 minutes)
RATE_LIMIT_MAX=100

# Auth rate limit (login/register)
AUTH_RATE_LIMIT_MAX=5

# =====================
# SECURITY
# =====================
# Enable/Disable security features
ENABLE_RATE_LIMITING=true
ENABLE_IP_BLACKLIST=true
ENABLE_CSRF_PROTECTION=false

# Max request size (in MB)
MAX_REQUEST_SIZE=10

# =====================
# FILE UPLOAD
# =====================
# Max file size for uploads (in MB)
MAX_FILE_SIZE=5

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# =====================
# SESSION (if using sessions instead of JWT)
# =====================
SESSION_SECRET=your_session_secret_key
SESSION_NAME=sessionId
SESSION_MAX_AGE=86400000

# =====================
# REDIS (for caching - optional)
# =====================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# =====================
# MONITORING & ANALYTICS (Optional)
# =====================
# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# =====================
# DEVELOPMENT ONLY
# =====================
# Seed database on startup (true/false)
SEED_DATABASE=false

# Enable debug mode
DEBUG=false

# =====================
# NOTES
# =====================
# 1. NEVER commit the .env file to git
# 2. Use strong, random values for secrets
# 3. Different values for dev/staging/production
# 4. Rotate secrets regularly in production
# 5. Use environment variables in CI/CD pipelines